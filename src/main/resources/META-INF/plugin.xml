<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.bumblebee202111.intellijcontextbridge</id>
    <name>IntelliJ Context Bridge</name>
    <vendor>bumblebee202111</vendor>
    <description><![CDATA[
        <p>Zero-API AI coding assistant plugin. Intelligently syncs IDE context (AST skeletons, diffs, state) with web-based AI playgrounds via Clipboard & WebSockets.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="java-support.xml">com.intellij.modules.java</depends>
    <depends optional="true" config-file="kotlin-support.xml">org.jetbrains.kotlin</depends>
    <depends optional="true" config-file="js-support.xml">JavaScript</depends>

    <extensionPoints>
        <extensionPoint name="skeletonExtractor" interface="com.github.bumblebee202111.intellijcontextbridge.context.LanguageSkeletonExtractor" dynamic="true"/>
        <extensionPoint name="graphExtractor" interface="com.github.bumblebee202111.intellijcontextbridge.context.LanguageGraphExtractor" dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow factoryClass="com.github.bumblebee202111.intellijcontextbridge.toolWindow.ContextBridgeToolWindowFactory"
                    id="Context Bridge"
                    anchor="right"/>
    </extensions>

    <actions>
        <action id="ContextBridge.GenerateCommitMessage"
                class="com.github.bumblebee202111.intellijcontextbridge.actions.GenerateCommitMessageAction"
                text="Generate AI Commit Message"
                description="Generate commit message using Gemini"
                icon="AllIcons.Actions.Commit">
            <add-to-group group-id="Vcs.MessageActionGroup" anchor="first"/>
        </action>
    </actions>
</idea-plugin>